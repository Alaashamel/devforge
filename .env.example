# ------------------------------------------------------------------
# DevForge environment configuration.
# Copy to .env and adjust for your machine. Never commit .env.
# ------------------------------------------------------------------

# --- API ----------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Local development database (matches docker compose dev postgres).
DATABASE_URL=postgres://devforge:devforge@localhost:5433/devforge

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# --- Auth ----------------------------------------------------------
# Access-token signing secret (>= 32 chars). MUST be set explicitly in
# production; the bundled dev default refuses to start in production.
JWT_ACCESS_SECRET=
# Access-token lifetime (jose notation, e.g. 15m, 1h).
JWT_ACCESS_TTL=15m
# Refresh-token lifetime in days (rotating, stored hashed server-side).
REFRESH_TTL_DAYS=7
# Base URL for email verification / password-reset links.
WEB_BASE_URL=http://localhost:5173

# Argon2id work factors (production defaults are 65536/3/1; lower them in
# constrained environments only).
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- Web -----------------------------------------------------------
# Optional; defaults to http://localhost:4000/api/v1 when unset.
VITE_API_URL=http://localhost:4000/api/v1
