# ------------------------------------------------------------------
# DevForge environment configuration.
# Copy to .env and adjust for your machine. Never commit .env.
# ------------------------------------------------------------------

# --- API ----------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Local development database (matches docker compose dev postgres).
DATABASE_URL=postgres://devforge:devforge@localhost:5433/devforge

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# --- Auth ----------------------------------------------------------
# Access-token signing secret (>= 32 chars). MUST be set explicitly in
# production; the bundled dev default refuses to start in production.
JWT_ACCESS_SECRET=
# Access-token lifetime (jose notation, e.g. 15m, 1h).
JWT_ACCESS_TTL=15m
# Refresh-token lifetime in days (rotating, stored hashed server-side).
REFRESH_TTL_DAYS=7
# Base URL for email verification / password-reset links.
WEB_BASE_URL=http://localhost:5173

# Argon2id work factors (production defaults are 65536/3/1; lower them in
# constrained environments only).
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- GitHub -------------------------------------------------------
# Public base URL of the API (used to build the webhook delivery URL).
# MUST be publicly reachable in production.
API_BASE_URL=http://localhost:4000
# OAuth app credentials from https://github.com/settings/developers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The GitHub redirect URI must match the callback configured on the app.
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/github/oauth/callback
# AES-256-GCM key material for encrypted access tokens (>= 16 chars).
# MUST be set explicitly in production; the bundled dev default refuses to
# start in production.
GITHUB_ENCRYPTION_KEY=
# Optional overrides; defaults to the real GitHub endpoints.
# GITHUB_OAUTH_URL=https://github.com/login/oauth
# GITHUB_API_URL=https://api.github.com
# User-Agent sent to the GitHub API.
GITHUB_APP_NAME=devforge

# --- Web -----------------------------------------------------------
# Optional; defaults to http://localhost:4000/api/v1 when unset.
VITE_API_URL=http://localhost:4000/api/v1

# --- AI service (apps/ai) -------------------------------------------
# Base URL of the isolated Python AI service. The API submits signed job
# intents here and the AI service pulls credential-free archives back from
# the API via AI_ARCHIVE_TTL_SECONDS-signed URLs.
AI_SERVICE_URL=http://localhost:5001
# HMAC secret shared between the API and AI service for job + archive tokens
# (>= 16 chars). MUST be set explicitly in production.
AI_JOB_SECRET=
# Lifetime of signed job tokens (seconds, 60-3600).
AI_JOB_TTL_SECONDS=300
# Lifetime of signed archive download tokens (seconds, 60-7200).
AI_ARCHIVE_TTL_SECONDS=900
