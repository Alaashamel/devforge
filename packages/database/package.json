{
  "name": "@devforge/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevForge database migration tooling and baseline schema",
  "exports": {
    ".": "./src/index.js",
    "./runner": "./src/runner.js",
    "./migrations/*": "./migrations/*"
  },
  "bin": {
    "df-db": "./src/cli.js"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env src/cli.js up",
    "migrate:up": "node --env-file-if-exists=../../.env src/cli.js up",
    "migrate:down": "node --env-file-if-exists=../../.env src/cli.js down",
    "migrate:status": "node --env-file-if-exists=../../.env src/cli.js status",
    "migrate:create": "node --env-file-if-exists=../../.env src/cli.js create",
    "seed": "node --env-file-if-exists=../../.env src/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "vitest": "^4.1.10"
  }
}
