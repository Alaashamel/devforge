{
  "name": "devforge",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered developer platform and engineering workspace",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "ai:dev": "python -m uvicorn app.main:app --reload --port 5001 --app-dir apps/ai",
    "ai:test": "python -m pytest apps/ai",
    "ai:lint": "python -m ruff check apps/ai",
    "build": "npm run build -w apps/web",
    "validate": "node infrastructure/scripts/validate-repo.mjs",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run migrate -w packages/database",
    "db:up": "npm run migrate -w packages/database",
    "db:down": "npm run migrate:down -w packages/database",
    "db:status": "npm run migrate:status -w packages/database",
    "db:migrate:create": "npm run migrate:create -w packages/database",
    "db:seed": "npm run seed -w packages/database"
  },
  "keywords": [
    "developer-platform",
    "project-management",
    "ai-code-review",
    "engineering-workspace"
  ],
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
