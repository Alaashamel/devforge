{
  "name": "devforge",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered developer platform and engineering workspace",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "validate": "node infrastructure/scripts/validate-repo.mjs",
    "test": "npm run test -ws --if-present",
    "lint": "npm run lint -ws --if-present"
  },
  "keywords": [
    "developer-platform",
    "project-management",
    "ai-code-review",
    "engineering-workspace"
  ],
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
