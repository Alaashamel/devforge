# ------------------------------------------------------------------
# DevForge production environment.
# Copy to .env.production and fill in every value. The API refuses
# to start when secrets are left at their dev defaults.
# ------------------------------------------------------------------

# --- API ----------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgres://devforge:CHANGE_ME@postgres:5432/devforge
CORS_ORIGINS=https://app.example.com

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
WEB_BASE_URL=https://app.example.com

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- GitHub -------------------------------------------------------
API_BASE_URL=https://api.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://api.example.com/api/v1/github/oauth/callback
GITHUB_ENCRYPTION_KEY=

# --- AI service ---------------------------------------------------
AI_JOB_SECRET=
AI_JOB_TTL_SECONDS=300
AI_ARCHIVE_TTL_SECONDS=900
AI_PRIMARY_PROVIDER=openai
AI_OPENAI_API_KEY=
# AI_ANTHROPIC_API_KEY=

# --- Edge proxy ---------------------------------------------------
HTTP_PORT=8080
